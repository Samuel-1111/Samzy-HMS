# Portal sign-in credentials. Set these in Vercel Project Settings > Environment Variables.
# Lowercase and uppercase names are both supported. Never use NEXT_PUBLIC_ for credentials.
# The Administrator portal is configured using the first pair:
admin_username=""
admin_password=""

# Optional until the corresponding portal is activated:
receptionist_username=""
receptionist_password=""

staff_username=""
staff_password=""

# IMPORTANT: this is currently one shared Patient Portal login, not individual patient accounts.
# Do not use a shared patient login for access to real patient records/PHI.
patient_username=""
patient_password=""

# Required for Vercel-session-based data actions. Set only after a real hospital
# tenant has been created and approved in the Supabase hospitals table.
HMS_HOSPITAL_ID=""

# CCTV discovery must run through an agent installed inside the hospital LAN.
# Vercel cannot send ONVIF multicast discovery packets into a private LAN.
