NEXT_PUBLIC_APP_NAME="Samzy HMS"

# Use the same Supabase Project URL in both variables:
# SUPABASE_URL is server-side; NEXT_PUBLIC_SUPABASE_URL is needed by browser/SSR clients.
SUPABASE_URL="https://nbumcghfpyurtuatarac.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://nbumcghfpyurtuatarac.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase secret. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SECRET_KEY=""

# Generate a fresh random value of at least 32 characters; configure in Vercel only.
HMS_BOOTSTRAP_TOKEN=""

# Portal sign-in credentials. Set these in Vercel Project Settings > Environment Variables.
# Lowercase and uppercase names are both supported. Never use NEXT_PUBLIC_ for credentials.
admin_username=""
admin_password=""

# Optional until the corresponding portal is activated:
receptionist_username=""
receptionist_password=""

staff_username=""
staff_password=""

# IMPORTANT: this is currently one shared Patient Portal login, not individual patient accounts.
# Do not use a shared patient login for access to real patient records/PHI.
patient_username=""
patient_password=""

# Set only after a real hospital tenant has been created and approved in Supabase.
HMS_HOSPITAL_ID=""

# Optional: CCTV discovery requires an agent installed inside the authorized hospital LAN.
CCTV_DISCOVERY_BRIDGE_URL=""
CCTV_DISCOVERY_BRIDGE_TOKEN=""
